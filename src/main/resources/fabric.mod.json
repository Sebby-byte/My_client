{
  "schemaVersion": 1,
  "id": "myclient",
  "version": "${version}",
  "name": "My Client",
  "description": "Anchor Macro, Auto Attack, Block Vision and Invisible Hitboxes in one mod, with one menu (Right Shift).",
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.example.anchormacro.AnchorMacro",
      "com.example.autoattack.AutoAttackClient",
      "com.example.bevision.BEVisionClient",
      "com.example.invisiblehitboxes.InvisibleHitboxesClient",
      "com.example.hub.ClientHub"
    ]
  },
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
